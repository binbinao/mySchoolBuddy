  "meta": {
    "schema": "renrendoc-index/1",
    "created": "2026-10-04",
    "purpose": "**人人文库试卷清单** —— 批量采集的输入清单（tools/batch_fetch_renrendoc.py 读它）。",
    "discovery_note": "⚠️ **人人文库没有可用的站内搜索接口**（`/search?q=` 返回 404）⇒ paperId **只能从外部搜索引擎逐个拿**。本清单是人工/搜索维护的，不是工具自动发现的。**要扩题库就得去搜，然后往这里加条目。**",
    "referer_trick": "⚠️ **Referer 必须是具体页面 URL**，用站点首页必定 403。这是整条采集链的技术要点。",
    "formula_quality": "**原卷扫描图公式完整**（分式/分数线/根号/全角标点都在）—— 这是它比 zujuan/教习网强的地方：那两个站的公式会被剥掉。",
    "count": 32,
    "domains": [
      {
        "prefix": "file4",
        "path": "view12/M06/.. 或 view/.."
      },
      {
        "prefix": "file2",
        "path": "fileroot_temp3/YYYY-MM/.."
      },
      {
        "note": "⚠️ **图链域名不止 file4**——2018 那份是 file2 + fileroot_temp3，第一版正则只匹配 file4+view 直接漏掉。已放宽为 file\\d+ + (view|fileroot_temp3)。"
      }
    ],
    "topic_collections": "🔴 **重要发现**：存在成体系的「五年真题分类汇编」（21-25 按考点分类，含原卷版与解析版）——**这是专题学习卷的现成题源，比自己出题靠谱**。已收录物理 8 个专题。",
    "preview_limit": {
      "finding": "🔴 **人人文库每份只给 5 张预览图，不是全卷**。",
      "evidence": "实测：电学计算汇编页面声明 52 页、图链只有 5 张；运动和力声明 29 页、图链 5 张；压强浮力声明 16 页、图链 5 张。",
      "implication": "**专题汇编只拿到开头 5 页**（约 10-15 题），不是完整的 52 页汇编。⇒ 建题库时不能把它当「完整专题卷」用，只能当「样题来源」。",
      "to_get_full": "完整版需付费下载（页面上的「下载」按钮）。**本项目走不通这条路**（无付费账号）。⇒ 补全只能靠：① 换别的站 ② 用户手买 ③ 用户手拍已有的纸质卷。",
      "check_tool": "`tools/batch_fetch_renrendoc.py` 每次都打印「共 N 张」，**N 恒为 5 就是预览**。若某份 N<5 才是真的抓不全。"
    }
  },
